{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/pagos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/derivaciones/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/colaboradores/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/:path((?!clinic-consent/|clinical-consent/guest/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/clinic-consent/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://api.health-hera.com; frame-src 'self'; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/clinical-consent/guest/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://api.health-hera.com; frame-src 'self'; manifest-src 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/legal/:path*",
      "destination": "https://api.health-hera.com/legal/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.health-hera.com/sitemap.xml"
    },
    {
      "source": "/clinic-consent/:requestId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/clinical-consent/guest/:requestId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/pagos/reserva/:bookingId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/pagos/bono/:patientPackageId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/calendar/session/:sessionId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/clinical-consent/:requestId/:token",
      "destination": "/app-shell.html"
    },
    {
      "source": "/clinic-consent/:requestId/:token",
      "destination": "/app-shell.html"
    },
    {
      "source": "/review/:token",
      "destination": "/app-shell.html"
    },
    {
      "source": "/especialista/:profileRef",
      "destination": "/app-shell.html"
    },
    {
      "source": "/e/:profileRef",
      "destination": "/app-shell.html"
    },
    {
      "source": "/reservar/:specialistId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/derivaciones/:id?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/colaboradores/:id?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/comisiones-hera/:accountId?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mi-clinica/:clinicId?/:section?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mi-clinica/:clinicId/pacientes/:clinicPatientId",
      "destination": "/app-shell.html"
    }
  ]
}
